contract "mundanereq-source-0.2"

requirement "CHILD"
title "Derived child behavior"
allocation "Subsystem"
statement [
  prose "The subsystem shall provide the behavior allocated by the parent requirement."
]
rationale [
  prose "The child identifies a separately reviewable implementation responsibility."
]
source null
decomposition-targets ["TOP"]
end requirement

requirement "LEAF"
title "Leaf timing behavior"
allocation null
statement [
  prose "The component shall complete the behavior within the interval defined by:"
  math latex "t_{complete} - t_{start} \\le 100\\,\\mathrm{ms}"
  prose "The interval uses a monotonic time source."
]
rationale null
source "TEST-SOURCE, revision A, section 4.2"
decomposition-targets ["CHILD", "TOP"]
end requirement

requirement "TOP"
title "Top-level behavior"
allocation "System"
statement [
  prose "The system shall provide the required externally observable behavior."
  prose "The behavior shall remain available throughout normal operation."
]
rationale [
  prose "The top-level requirement defines the user-visible outcome independently of implementation."
]
source "TEST-SOURCE, revision A, section 4"
decomposition-targets []
end requirement

relationships [
  "CHILD" -> "TOP"
  "LEAF" -> "CHILD"
  "LEAF" -> "TOP"
]

