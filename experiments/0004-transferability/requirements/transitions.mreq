requirement LPC_TB_STAY_ON_NEXT
title: Remain thrust-borne
allocation: vehicle
statement:
  Whenever lift_mode = thrust_borne & kgs <= 20.0 & hover_control_mode the vehicle shall at the
  next timepoint satisfy lift_mode = thrust_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_TB_STAY_ON_NEXT
end requirement

requirement LPC_STB_STAY_ON_NEXT
title: Remain semi-thrust-borne
allocation: vehicle
statement:
  Whenever lift_mode = semi_thrust_borne & kias <= 40.0 & (kgs > 20.0 | !hover_control_mode)
  the vehicle shall at the next timepoint satisfy lift_mode = semi_thrust_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_STB_STAY_ON_NEXT
end requirement

requirement LPC_SWB_TO_STB
title: Transition from semi-wing-borne to semi-thrust-borne
allocation: vehicle
statement:
  Upon lift_mode = semi_wing_borne & kias <= 30.0 the vehicle shall at  the next timepoint satisfy
  lift_mode = semi_thrust_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_SWB_TO_STB
end requirement

requirement LPC_STB_TO_SWB
title: Transition from semi-thrust-borne to semi-wing-borne
allocation: vehicle
statement:
  Upon lift_mode = semi_thrust_borne & kias > 40.0 the vehicle shall at the next timepoint satisfy
  lift_mode = semi_wing_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_STB_TO_SWB
end requirement

requirement LPC_STB_TO_TB
title: Transition from semi-thrust-borne to thrust-borne
allocation: vehicle
statement:
  Upon lift_mode = semi_thrust_borne & hover_control_mode & kgs <= 20.0 the vehicle shall at the
  next timepoint satisfy lift_mode = thrust_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_STB_TO_TB
end requirement

requirement LPC_SWB_TO_WB
title: Transition from semi-wing-borne to wing-borne
allocation: vehicle
statement:
  Upon lift_mode = semi_wing_borne & kias > 100.0 the vehicle shall at the next timepoint satisfy
  lift_mode = wing_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_SWB_TO_WB
end requirement

requirement LPC_TB_TO_STB
title: Transition from thrust-borne to semi-thrust-borne
allocation: vehicle
statement:
  Upon lift_mode = thrust_borne & (!hover_control_mode |  kgs > 20.0) the vehicle shall at the
  next timepoint satisfy lift_mode = semi_thrust_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_TB_TO_STB
end requirement

requirement LPC_WB_TO_SWB
title: Transition from wing-borne to semi-wing-borne
allocation: vehicle
statement:
  Upon  lift_mode = wing_borne & kias <= 90.0 the vehicle shall at the next timepoint satisfy
  lift_mode = semi_wing_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_WB_TO_SWB
end requirement

requirement LPC_SWB_STAY_ON_NEXT
title: Remain semi-wing-borne
allocation: vehicle
statement:
  Whenever lift_mode = semi_wing_borne & kias <= 100.0 & kias > 30.0 the vehicle shall at the
  next timepoint satisfy lift_mode = semi_wing_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_SWB_STAY_ON_NEXT
end requirement

requirement LPC_WB_STAY_ON_NEXT
title: Remain wing-borne
allocation: vehicle
statement:
  Whenever  lift_mode = wing_borne & kias > 90.0 the vehicle shall at the next timepoint satisfy
  lift_mode = wing_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_WB_STAY_ON_NEXT
end requirement
