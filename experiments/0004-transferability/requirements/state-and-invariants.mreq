requirement LPC_INIT_LIFT_MODE
title: Initial lift mode
allocation: vehicle
statement:
  The vehicle shall immediately satisfy lift_mode = wing_borne <=> kias >= 90.0
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_INIT_LIFT_MODE
end requirement

requirement LPC_LIFT_MODE
title: Permitted lift modes
allocation: vehicle
statement:
  The vehicle shall always satisfy lift_mode = thrust_borne | lift_mode = semi_thrust_borne |
  lift_mode = semi_wing_borne | lift_mode = wing_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_LIFT_MODE
end requirement

requirement LPC_INIT_KIAS
title: Initial indicated airspeed
allocation: vehicle
statement:
  The vehicle shall immediately satisfy kias = 120.0
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_INIT_KIAS
end requirement

requirement LPC_KIAS_KGS
title: Airspeed equality
allocation: vehicle
statement:
  The vehicle shall always satisfy kias = kgs
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_KIAS_KGS
end requirement

requirement LPC_KIAS_DERIVATIVE
title: Airspeed rate bound
allocation: vehicle
statement:
  The vehicle shall always satisfy FTP | absReal(preReal(0.0, kias) - kias) <= 10.0
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_KIAS_DERIVATIVE
end requirement

requirement LPC_INIT_HOVER_MODE
title: Initial hover-control mode
allocation: vehicle
statement:
  The vehicle shall immediately satisfy hover_control_mode <=> kgs < 20.0
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_INIT_HOVER_MODE
end requirement

requirement LPC_KIAS_0
title: Nonnegative indicated airspeed
allocation: vehicle
statement:
  The vehicle shall always satisfy kias >= 0.0
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_KIAS_0
end requirement

requirement LPC_REACH_HOVER_06
title: Reach hover within six ticks
allocation: vehicle
statement:
  The vehicle shall within 6 ticks satisfy lift_mode = thrust_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_REACH_HOVER_06
end requirement

requirement LPC_REACH_HOVER_12
title: Reach hover within twelve ticks
allocation: vehicle
statement:
  The vehicle shall within 12 ticks satisfy lift_mode = thrust_borne
source: Adapted from NASA-SW-VnV/fret@cf0f913cc15c41705e803593297e89cd6056b839:caseStudies/LiftPlusCruise/LPC_mini_reqts_and_vars.json#reqid=LPC_REACH_HOVER_12
end requirement
